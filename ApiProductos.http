@ApiProductos_HostAddress = http://localhost:5021
@apiKey = admin-key

GET {{ApiProductos_HostAddress}}/api/productos
Accept: application/json

###

POST {{ApiProductos_HostAddress}}/api/productos
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "nombre": "Teclado mecánico",
  "precio": 150000,
  "stock": 10
}

###

GET {{ApiProductos_HostAddress}}/api/productos/1
Accept: application/json

###

PUT {{ApiProductos_HostAddress}}/api/productos/1
Content-Type: application/json
X-API-KEY: {{apiKey}}

{
  "nombre": "Teclado mecánico RGB",
  "precio": 175000,
  "stock": 8
}

###

DELETE {{ApiProductos_HostAddress}}/api/productos/1
X-API-KEY: {{apiKey}}

###

GET {{ApiProductos_HostAddress}}/api/productos?filtroNombre=teclado&ordenarPor=-precio
Accept: application/json
X-API-KEY: {{apiKey}}
